    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 3,
      "raw": "This directory owns the in-repo automated regression suite for WhatSon.\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
      "start_line": 4,
      "end_line": 4,
      "raw": "\n"
    },
    {
      "id": "b000005",
      "kind": "paragraph",
      "start_line": 5,
      "end_line": 6,
      "raw": "The maintained regression surface combines root-level build gates with a Qt Test based C++ runtime suite under\n`test/cpp/`.\n"
    },
    {
      "id": "b000006",
      "kind": "blank",
      "start_line": 7,
      "end_line": 7,
      "raw": "\n"
    },
    {
