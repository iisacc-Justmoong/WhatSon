          "checked": null
        },
        {
          "marker": "-",
          "text": "`calendarDetailActive`",
          "checked": null
        }
      ]
    },
    {
      "id": "b000014",
      "kind": "blank",
      "start_line": 20,
      "end_line": 20,
      "raw": "\n"
    },
    {
