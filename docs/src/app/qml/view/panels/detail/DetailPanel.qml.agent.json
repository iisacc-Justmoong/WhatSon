      "raw": "\n"
    },
    {
      "id": "b000012",
      "kind": "heading",
      "start_line": 14,
      "end_line": 14,
      "raw": "## 주요 계약\n",
      "level": 2,
      "title": "주요 계약"
    },
    {
      "id": "b000013",
      "kind": "list",
      "start_line": 15,
      "end_line": 19,
      "raw": "- `noteDetailPanelController`\n- `resourceDetailPanelController`\n- `sidebarHierarchyController`\n- `resourcesHierarchyController`\n- `calendarDetailActive`\n",
      "items": [
        {
          "marker": "-",
          "text": "`noteDetailPanelController`",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`resourceDetailPanelController`",
          "checked": null
        },
        {
