      "kind": "heading",
      "start_line": 11,
      "end_line": 11,
      "raw": "## 입력\n",
      "level": 2,
      "title": "입력"
    },
    {
      "id": "b000012",
      "kind": "list",
      "start_line": 12,
      "end_line": 15,
      "raw": "- `emptyStateText`\n- `manualFallbackText`\n- `hierarchyItems`\n- `manualFallbackEnabled`\n",
