    {
      "id": "b000006",
      "kind": "paragraph",
      "start_line": 6,
      "end_line": 6,
      "raw": "`NavigationApplicationEditBar.qml`는 탐색 모드가 `Edit`일 때 오른쪽 응용 프로그램 도구 모음 클러스터를 렌더링합니다.\n"
    },
    {
      "id": "b000007",
      "kind": "blank",
      "start_line": 7,
      "end_line": 7,
      "raw": "\n"
    },
