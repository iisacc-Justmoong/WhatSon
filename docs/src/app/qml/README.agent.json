    },
    {
      "id": "b000007",
      "kind": "paragraph",
      "start_line": 7,
      "end_line": 7,
      "raw": "`view/panels/ContentViewLayout.qml` composes the workspace content area with:\n"
    },
    {
      "id": "b000008",
      "kind": "blank",
      "start_line": 8,
      "end_line": 8,
