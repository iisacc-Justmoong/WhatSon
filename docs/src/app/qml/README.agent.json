    },
    {
      "id": "b000010",
      "kind": "blank",
      "start_line": 10,
      "end_line": 10,
      "raw": "\n"
    },
    {
      "id": "b000011",
      "kind": "paragraph",
      "start_line": 11,
      "end_line": 11,
      "raw": "The active editor document model was deleted. QML no longer receives a document session, editor paste bridge, or native key filter, and it must not reconstruct those responsibilities as compatibility wrappers.\n"
    }
