    {
      "id": "b000011",
      "kind": "paragraph",
      "start_line": 14,
      "end_line": 14,
      "raw": "Clipboard import stops at persisted resource packages and resource list updates. The editor document paste bridge was deleted, so this shard must not insert RAW body tags, mutate active editor text, or expose editor item key-filter behavior.\n"
    }
