    {
      "id": "b000007",
      "kind": "paragraph",
      "start_line": 7,
      "end_line": 7,
      "raw": "`InAppClipboardManager`에서 사용하는 단일 리소스 클립보드 스냅샷 저장소를 구현합니다.\n"
    },
    {
      "id": "b000008",
      "kind": "blank",
      "start_line": 8,
      "end_line": 8,
      "raw": "\n"
    },
    {
