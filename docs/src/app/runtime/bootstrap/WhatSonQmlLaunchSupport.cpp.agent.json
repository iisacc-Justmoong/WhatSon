    {
      "id": "b000006",
      "kind": "paragraph",
      "start_line": 6,
      "end_line": 6,
      "raw": "앱 구성 루트에 대한 QML 루트 로딩을 구현합니다.\n"
    },
    {
      "id": "b000007",
