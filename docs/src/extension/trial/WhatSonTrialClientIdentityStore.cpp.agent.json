    {
      "id": "b000006",
      "kind": "paragraph",
      "start_line": 6,
      "end_line": 6,
      "raw": "평가판 전용 클라이언트 ID 지속성 계층을 구현합니다.\n"
    },
    {
      "id": "b000007",
